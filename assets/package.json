{
  "name": "suivi-production-oulmes",
  "version": "1.1.0",
  "private": true,
  "description": "Suivi de production Oulmès - Android et Windows",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "desktop": "electron electron-main.cjs",
    "build:windows": "electron-builder --win nsis"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.oulmes.suiviproduction",
    "productName": "Suivi Production Oulmes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Suivi Production Oulmès"
    },
    "extraMetadata": {
      "main": "electron-main.cjs"
    }
  }
}
